{% comment %}
  Title: Custom Product List
  Description: A list of custom product cards configurable using blocks upto "6" with quick view modal.
{% endcomment %}

{{ 'custom-product-list.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'pill.css' |  asset_url | stylesheet_tag }}

<script src="{{ 'customQuickAddModal.js' | asset_url }}" defer></script>
<script src="{{ 'customModalOpener.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{% assign upsell_product = settings.upsell_product %}
{% assign upsell_product_form_id = 'quick-add-' | append: section.id | append: product.id %}

{% comment %} Quick Add Modal gradient overlay {% endcomment %}
<div class="custom-modal-overlay">
</div>

{% comment %} This product form is to add upsell product to the cart. {% endcomment %}
<product-form
data-product-id="{{ upsell_product.id }}"
class="product-form upsell-product-form"
data-hide-errors="{{ gift_card_recipient_feature_active }}"
data-section-id="{{ section.id }}"
>
  <div class="product-form__error-message-wrapper" role="alert" hidden>
    <span class="svg-wrapper">
      {{- 'icon-error.svg' | inline_asset_content -}}
    </span>
    <span class="product-form__error-message"></span>
  </div>
  {%- form 'product',
    upsell_product,
    id: upsell_product_form_id,
    class: 'form',
    novalidate: 'novalidate',
    data-type: 'add-to-cart-form'
  -%}
    <input
      type="hidden"
      name="id"
      value="{{ upsell_product.selected_or_first_available_variant.id }}"
      {% if upsell_product.selected_or_first_available_variant.available == false
        or quantity_rule_soldout
        or upsell_product.selected_or_first_available_variant == null
      %}
        disabled
      {% endif %}
      class="product-variant-id"
    >

    {%- if gift_card_recipient_feature_active -%}
      {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
    {%- endif -%}

    <div class="product-form__buttons">
      {%- liquid
        assign check_against_inventory = true
        if upsell_product.selected_or_first_available_variant.inventory_management != 'shopify' or upsell_product.selected_or_first_available_variant.inventory_policy == 'continue'
          assign check_against_inventory = false
        endif
        if upsell_product.selected_or_first_available_variant.quantity_rule.min > upsell_product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
          assign quantity_rule_soldout = true
        endif
      -%}
      <button
        id="ProductSubmitButton-{{ section.id }}"
        type="submit"
        name="add"
        class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
        {% if upsell_product.selected_or_first_available_variant.available == false
          or quantity_rule_soldout
          or upsell_product.selected_or_first_available_variant == null
        %}
          disabled
        {% endif %}
      >
        <span>
          {%- if upsell_product.selected_or_first_available_variant == null -%}
            {{ 'products.product.unavailable' | t }}
          {%- elsif upsell_product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
            {{ 'products.product.sold_out' | t }}
          {%- else -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- endif -%}
        </span>
        {%- render 'loading-spinner' -%}
      </button>
      {%- if show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
    </div>
  {%- endform -%}
</product-form>

<div class="custom-product-list__main">
  <div class="custom-product-list__header">
    <h2 class="h2 custom-product-list__title">{{ section.settings.custom_list_title }}</h2>
  </div>
  <ul class="custom-product-list__container">
    {% for block in section.blocks %}
      <li class="custom-product-list__item">
        {% assign card_product = block.settings.product %}
        {% render 'custom-product-card', product: card_product, section_id: section.id %}
      </li>
    {% endfor %}
  </ul>
</div>
{% schema %}
{
  "name": "Custom Product List",
  "settings": [
    {
      "type": "header",
      "content": "Product List Settings"
    },
    {
      "type": "text",
      "id": "custom_list_title",
      "label": "Section Title",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "checkbox",
      "id": "autofill_first_variant",
      "label": "Auto Select First available Variant at quick add modal",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product List",
      "category": "Custom",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
